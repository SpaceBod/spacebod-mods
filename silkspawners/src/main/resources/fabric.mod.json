	"authors": [
		"SpaceBod"
	],
	"contact": {
		"homepage": "https://github.com/SpaceBod/spacebod-mods",
		"sources": "https://github.com/SpaceBod/spacebod-mods",
		"issues": "https://github.com/SpaceBod/spacebod-mods/issues"
	},
	"license": "MIT",
	"icon": "assets/spacebod_silkspawners/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"dev.spacebod.silkspawners.SilkSpawners"
		],
		"modmenu": [
			"dev.spacebod.silkspawners.client.modmenu.SilkSpawnersModMenu"
		]
	},
	"mixins": [
		"spacebod_silkspawners.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "${minecraft_range}",
